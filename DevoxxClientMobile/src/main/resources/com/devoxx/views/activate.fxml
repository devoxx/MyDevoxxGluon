<?xml version="1.0" encoding="UTF-8"?>

<?import com.gluonhq.charm.glisten.mvc.View?>
<?import javafx.scene.layout.VBox?>
<?import com.gluonhq.charm.glisten.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Hyperlink?>
<?import com.gluonhq.charm.glisten.control.Icon?>
<View fx:id="activateView" styleClass="activate-view" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.devoxx.views.ActivatePresenter">
    <VBox styleClass="container">
        <Icon styleClass="icon" content="LOCK"/>
        <Label styleClass="legend" text="%OTN.ACTIVATION.LEGEND"/>
        <TextField fx:id="username" styleClass="username" promptText="%OTN.ACTIVATION.PROMPT"/>
        <Button fx:id="submit" styleClass="submit" text="%OTN.ACTIVATION.BUTTON" onAction="#submit"/>
        <Hyperlink fx:id="link" styleClass="links" text="%OTN.ACTIVATION.LINK" onAction="#authenticate" visible="false"/>
    </VBox>
</View>